# Copy to .env.local in this checkout; never commit real keys.
# The localhost Persona Worker reads this file on startup. No VITE_ key variables.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Local autonomous finishing. Start DaVinci Resolve and its installed Lua bridge.
PERSONA_STUDIO_OPENAI_MODEL=gpt-4.1-mini
PERSONA_STUDIO_GEMINI_MODEL=gemini-3.5-flash-lite
PERSONA_STUDIO_OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
PERSONA_STUDIO_OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
PERSONA_STUDIO_PYTHON=
PERSONA_STUDIO_RESOLVE_LAUNCHER=
PERSONA_STUDIO_LUT_DIR=
# Optional public localhost port for an isolated frontend. Use the same port for the Worker.
VITE_PERSONA_WORKER_PORT=
# Optional override. Default: G:/test-persona/reference_videos
PERSONA_STUDIO_REFERENCE_DIR=
PERPLEXITY_API_KEY=
PERSONA_IDEAS_OPENAI_MODEL=gpt-4.1-mini
PERSONA_IDEAS_PERPLEXITY_MODEL=openai/gpt-5.6-sol
# No cloud request runs on startup. The Idea and Studio actions ask for consent.
