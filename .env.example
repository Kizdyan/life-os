# Copy to .env.local in this checkout; never commit real keys.
# The localhost Persona Worker reads this file on startup. No VITE_ key variables.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Local FFmpeg studio.
PERSONA_STUDIO_OPENAI_MODEL=gpt-4.1-mini
PERSONA_STUDIO_GEMINI_MODEL=gemini-3.5-flash-lite
PERSONA_STUDIO_OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
PERSONA_STUDIO_OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
PERSONA_STUDIO_PYTHON=
# Move the directory with luts/ and reference_videos/ by editing this one value.
# Default: Documents/Persona inside the user's home directory.
PERSONA_MEDIA_ROOT=
# Only for an independently started development frontend. START_PERSONA.bat uses localhost:3000.
VITE_PERSONA_WORKER_PORT=
PERPLEXITY_API_KEY=
PERSONA_IDEAS_OPENAI_MODEL=gpt-4.1-mini
PERSONA_IDEAS_PERPLEXITY_MODEL=openai/gpt-5.6-sol
# No cloud request runs on startup. The Idea and Studio actions ask for consent.

# Optional local fallback track for Music Studio auto music, relative to PERSONA_MEDIA_ROOT.
PERSONA_MUSIC_FALLBACK=
# Optional localhost frontend port for running an isolated copy.
PERSONA_MUSIC_ORIGIN_PORT=

# Local face crop and QA use opencv-python-headless and OpenCV YuNet ONNX.
PERSONA_STUDIO_FACE_MODEL=
# Optional local directory for validated Vision results. Defaults to vision-cache inside the Worker output root.
PERSONA_VISION_CACHE_DIR=
