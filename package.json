{
  "name": "life-os",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "api:typecheck": "tsc -p api/tsconfig.json --noEmit",
    "web:dev": "vite apps/web",
    "web:build": "vite build apps/web",
    "persona:qa": "node --experimental-strip-types scripts/persona-video-qa.mjs",
    "skills:inspect": "node scripts/skill-source-inspect.mjs",
    "qa:local": "node --experimental-strip-types --test scripts/remotion-skill-review.test.mjs scripts/skill-source-inspect.test.mjs scripts/skill-source-verify-git.test.mjs scripts/persona-video-measure.test.mjs scripts/persona-video-qa.test.mjs scripts/skill-catalog-find.test.mjs",
    "skills:verify-source": "node scripts/skill-source-verify-git.mjs",
    "skills:review-remotion": "node scripts/remotion-skill-review.mjs",
    "skills:find": "node scripts/skill-catalog-find.mjs",
    "skills:find:test": "node --test scripts/skill-catalog-find.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
