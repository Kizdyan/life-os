    "persona:scenario:doctor:task": "node tools/persona-local-script-doctor-task.mjs",
    "persona:scenario:doctor:test": "node --test tools/persona-local-script-doctor.test.mjs tools/persona-local-script-doctor-task.test.mjs tools/persona-local-doctor-patches.test.mjs",
