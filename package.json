    "media:take:qa": "node tools/persona-take-qa.mjs",
    "media:shoot:intake": "node tools/persona-shoot-intake.mjs",
    "media:subtitle:draft": "node tools/persona-subtitle-draft.mjs",
    "media:editorial": "node tools/persona-editorial-choices.mjs",
    "media:editorial:previews": "node tools/persona-editorial-previews.mjs",
    "media:review:kit": "node tools/persona-review-kit.mjs",
    "media:review:render": "node tools/persona-reviewed-render.mjs",
    "media:visual:review": "node tools/persona-visual-review.mjs",
    "media:visual:finalize": "node tools/persona-visual-finalize.mjs",
