{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run typecheck && npm run api:typecheck && npm test && npm run web:build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sw.js$|manifest.webmanifest$|favicon.ico$).*)",
      "destination": "/index.html"
    }
  ]
}
