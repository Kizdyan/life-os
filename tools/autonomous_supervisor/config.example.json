{
  "db_path": "~/.life-os-supervisor/supervisor.db",
  "repo_path": "../..",
  "worktree_root": "~/.life-os-supervisor/worktrees",
  "mission_path": "mission.v1.json",
  "default_base_ref": "feature/autonomous-supervisor-runtime-v1",
  "bind_host": "127.0.0.1",
  "bind_port": 8787,
  "loop_seconds": 15,
  "codex_retry_seconds": 1800,
  "protected_branches": [
    "main",
    "recovery/iphone-static-supabase"
  ],
  "test_commands": [
    "TZ=UTC npm test -- --run",
    "npm run typecheck",
    "npm run web:build"
  ],
  "command_timeout_seconds": 7200,
  "local_ai_command": ["ollama", "run", "qwen2.5-coder:1.5b"],
  "local_ai_model": "qwen2.5-coder:1.5b",
  "local_ai_max_concurrency": 1
}
