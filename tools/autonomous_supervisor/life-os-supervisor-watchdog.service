[Unit]
Description=Life OS Supervisor watchdog
After=life-os-supervisor.service

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'for i in 1 2 3 4 5; do curl -fsS --max-time 5 http://127.0.0.1:8787/api/status | python3 -c "import json,sys; x=json.load(sys.stdin); a=next((v for v in x.values() if isinstance(v,int) and not isinstance(v,bool)),None); raise SystemExit(0 if a is not None and a < 75 else 1)" && exit 0; sleep 2; done; systemctl restart life-os-supervisor.service'

